# ── Frontend (local dev only — optional) ─────────────────────────────────────
# Leave empty: the app uses same-origin /api routes, both on Vercel and locally
# (the Vite dev server on http://localhost:5173 proxies /api to the backend).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api requests. Defaults to the local backend.
# Keep it in sync with PORT below if you change the backend port.
VITE_API_PROXY_TARGET=http://localhost:5001

# ── Backend (local dev only) ─────────────────────────────────────────────────
# Port for the standalone API server (`npm run dev:backend`).
PORT=5001

# ── Contact form (serverless) ────────────────────────────────────────────────
# Optional: POST contact submissions to a webhook (Discord, Zapier, Make, etc.)
CONTACT_WEBHOOK_URL=

# Optional: Send contact form emails via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_EMAIL=fahimistiaq456@gmail.com
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
